{
  "name": "community-lending-library-5105",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' react-router dev",
    "dev:test": "react-router dev --mode test --port 3001",
    "build": "react-router build",
    "start": "NODE_ENV=production NODE_OPTIONS='--import ./instrument.server.mjs' react-router-serve ./build/server/index.js",
    "docker": "docker compose up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:colors": "tsx scripts/generate_colors.ts",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint --max-warnings=0 .",
    "lint:fix": "eslint --cache --cache-location ./node_modules/.cache/eslint --fix --max-warnings=0 .",
    "postinstall": "prisma generate",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start:mocks": "cross-env NODE_ENV=production NODE_OPTIONS=\"--require ./mocks --require dotenv/config\" react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:e2e:run": "npx playwright test",
    "test:db:reset": "node --env-file=.env.test ./node_modules/.bin/prisma migrate reset --force",
    "typecheck": "react-router typegen && tsc",
    "step-check": "npm run typecheck && npm run lint && npm run format",
    "ship-check": "npm run docker && npm run typecheck && npm run test -- --run && npm run build && npm run test:e2e:run && npm run lint && npm run format",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
