{
  "name": "community-lending-library-5105",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:test": "react-router dev --mode test --port 3001",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "docker": "docker compose up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:colors": "tsx scripts/generate_colors.ts",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "postinstall": "prisma generate",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start:mocks": "cross-env NODE_ENV=production NODE_OPTIONS=\"--require ./mocks --require dotenv/config\" react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:e2e:run": "npx playwright test",
    "test:db:reset": "node --env-file=.env.test ./node_modules/.bin/prisma migrate reset --force",
    "typecheck": "react-router typegen && tsc",
    "validate": "npm-run-all --parallel \"test -- --run\" lint typecheck test:e2e:run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/postgres-data"
  ],
